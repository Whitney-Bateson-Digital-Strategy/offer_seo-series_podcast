
---
import { formEmbedUrl } from "../lib/series";

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Rendered at build time and refreshed in the browser, like the rest of the page.
const embed = formEmbedUrl(new Date());
---

<section id="closing" class="closer">
  <video
    class="closer-video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={`${base}/closer-bg.jpg`}
    aria-hidden="true"
  >
    <source
      src={`${base}/closer-bg.webm`}
      type="video/webm"
    />
    <source
      src={`${base}/closer-bg.mp4`}
      type="video/mp4"
    />
  </video>

  <div class="wrap">
    <p class="eyebrow" id="cl-eyebrow">See you Thursday, Oct 29 at 2 pm ET</p>

    <p class="script">Our final episode, recorded live</p>

    <h2 id="cl-h2">
      Watch us audit two real practice websites <em>live</em>
    </h2>

    <p class="sub" id="cl-lead">
      We’ll point out what we’d fix first on each site, answer your questions, and give you a first look at our new SEO services. Anyone can join, and submitting your site for an audit is totally optional.
    </p>

    {embed && (
      <div class="cl-form" id="cl-form">
        <p class="cl-form-k">Save your seat</p>
        <iframe
          class="airtable-embed"
          id="cl-iframe"
          src={embed}
          title="Save your seat for the live audit"
          width="100%"
          height="800"
          loading="lazy"
        ></iframe>
      </div>
    )}

    <!-- Falls back to the button when there's no embed link, and comes back
         after the live taping, when the form is replaced by "Listen". -->
    <a
      class="btn btn-p"
      href="#"
      data-form
      id="cl-btn"
      style={embed ? "display:none" : undefined}
    >
      Save my seat for the live audit
    </a>
  </div>
</section>
