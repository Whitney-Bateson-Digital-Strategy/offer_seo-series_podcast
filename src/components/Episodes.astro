---
import { SERIES } from "../data/series";
import { renderEpisodes } from "../lib/series";
---
<section id="episodes">
  <div class="wrap">
    <div class="center">
      <!-- The Growth Show cover art: drop growth-show.jpg into public/ and it appears here -->
      <img class="show-art" src="/growth-show.jpg" alt="The Growth Show with Whitney Bateson" width="120" height="120" onerror="this.remove()">
      <p class="date-line">Oct 26 – Nov 2</p>
      <h2 class="h2 ep-h2">Here’s what we’re talking about <em>each day</em></h2>
      <p class="lead ep-intro">A new episode drops on The Growth Show each day, Monday through Wednesday. Then on Thursday, we tape the final episode live with you! 🎙️</p>
    </div>
    <!-- Rendered at build time so the episodes are in the HTML; the page script re-renders it live -->
    <div class="ep-list" id="ep-list" set:html={renderEpisodes(new Date(), false)}></div>
    <div class="listen-row">
      <a class="btn btn-s btn-sm" id="apple-link" href={SERIES.appleShow} target="_blank" rel="noopener"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><defs><linearGradient id="apg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F452FF"/><stop offset="1" stop-color="#832BC1"/></linearGradient></defs><rect width="24" height="24" rx="5.5" fill="url(#apg)"/><g fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round"><path d="M7.6 15.6a6.2 6.2 0 1 1 8.8 0"/><path d="M9.6 13.4a3.3 3.3 0 1 1 4.8 0"/></g><circle cx="12" cy="10.6" r="1.6" fill="#fff"/><path d="M11 13.4h2l-.35 5.3h-1.3z" fill="#fff"/></svg>Listen on Apple</a>
      <a class="btn btn-s btn-sm" id="spotify-link" href={SERIES.spotifyShow} target="_blank" rel="noopener"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="#1DB954" d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>Listen on Spotify</a>
    </div>
  </div>
</section>
